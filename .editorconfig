# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# The Python tooling uses 4 spaces.
[*.py]
indent_size = 4

# Markdown: keep trailing whitespace (it is meaningful in some tables).
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{mp4,png,jpg,jpeg,gif,ico,webp}]
insert_final_newline = false
